print("\n============================================")
print("HOTEL BOOKING EDA COMPLETED SUCCESSFULLY")
print("============================================")

print("Original/Current Dataset Shape :", hotel.shape)
print("Cleaned Dataset                : hotel_booking_cleaned.csv")
print("Cleaned Excel                  : hotel_booking_cleaned.xlsx")
print("YData Report                   : Hotel_Booking_Report.html")
print("Sweetviz Report                : Hotel_Booking_Sweetviz_Report.html")
print("============================================")
